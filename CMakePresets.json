{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "environment": {
        "VCPKG_DEFAULT_BINARY_CACHE": "${sourceDir}/.vcpkg-cache"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "environment": {
        "VCPKG_FORCE_SYSTEM_BINARIES": "1"
      }
    },
    {
      "name": "macos",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset":      { "value": "host=x64", "strategy": "external" }
    },

    { "name": "linux-debug",    "inherits": "linux",   "displayName": "Linux Debug",     "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug"   } },
    { "name": "linux-release",  "inherits": "linux",   "displayName": "Linux Release",   "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    {
      "name": "linux-asan",
      "inherits": "linux",
      "displayName": "Linux Debug + ASan/UBSan (clang)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SAMPLE_ENABLE_SANITIZERS": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },

    { "name": "macos-debug",    "inherits": "macos",   "displayName": "macOS Debug",     "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug"   } },
    { "name": "macos-release",  "inherits": "macos",   "displayName": "macOS Release",   "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    {
      "name": "macos-asan",
      "inherits": "macos",
      "displayName": "macOS Debug + ASan/UBSan (clang)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SAMPLE_ENABLE_SANITIZERS": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },

    { "name": "windows-debug",   "inherits": "windows", "displayName": "Windows Debug",   "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug"   } },
    { "name": "windows-release", "inherits": "windows", "displayName": "Windows Release", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
  ],
  "buildPresets": [
    { "name": "linux-debug",     "configurePreset": "linux-debug",     "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"   } },
    { "name": "linux-release",   "configurePreset": "linux-release",   "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"   } },
    { "name": "linux-asan",      "configurePreset": "linux-asan",      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"   } },
    { "name": "macos-debug",     "configurePreset": "macos-debug",     "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"  } },
    { "name": "macos-release",   "configurePreset": "macos-release",   "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"  } },
    { "name": "macos-asan",      "configurePreset": "macos-asan",      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"  } },
    { "name": "windows-debug",   "configurePreset": "windows-debug",   "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }, "configuration": "Debug"   },
    { "name": "windows-release", "configurePreset": "windows-release", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }, "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "linux-debug",     "configurePreset": "linux-debug",     "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"   }, "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error", "stopOnFailure": false } },
    { "name": "linux-release",   "configurePreset": "linux-release",   "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"   }, "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error", "stopOnFailure": false } },
    { "name": "linux-asan",      "configurePreset": "linux-asan",      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"   }, "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error", "stopOnFailure": false } },
    { "name": "macos-debug",     "configurePreset": "macos-debug",     "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"  }, "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error", "stopOnFailure": false } },
    { "name": "macos-release",   "configurePreset": "macos-release",   "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"  }, "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error", "stopOnFailure": false } },
    { "name": "macos-asan",      "configurePreset": "macos-asan",      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"  }, "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error", "stopOnFailure": false } },
    { "name": "windows-debug",   "configurePreset": "windows-debug",   "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }, "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error", "stopOnFailure": false }, "configuration": "Debug"   },
    { "name": "windows-release", "configurePreset": "windows-release", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }, "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error", "stopOnFailure": false }, "configuration": "Release" }
  ],
  "workflowPresets": [
    {
      "name": "ci-linux",
      "steps": [
        { "type": "configure", "name": "linux-release" },
        { "type": "build",     "name": "linux-release" },
        { "type": "test",      "name": "linux-release" }
      ]
    },
    {
      "name": "ci-macos",
      "steps": [
        { "type": "configure", "name": "macos-release" },
        { "type": "build",     "name": "macos-release" },
        { "type": "test",      "name": "macos-release" }
      ]
    },
    {
      "name": "ci-windows",
      "steps": [
        { "type": "configure", "name": "windows-release" },
        { "type": "build",     "name": "windows-release" },
        { "type": "test",      "name": "windows-release" }
      ]
    }
  ]
}
